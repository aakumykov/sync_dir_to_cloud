<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <CheckBoxPreference
        android:defaultValue="@bool/DEFAULT_settings_re_create_missing_source_and_target_dirs"
        android:key="@string/KEY_settings_re_create_missing_source_and_target_dirs"
        android:title="@string/SETTINGS_re_create_missing_source_and_target_dirs"
        android:summary="@string/SETTINGS_SUMMARY_re_create_missing_source_and_target_dirs"
        />

    <androidx.preference.EditTextPreference
        android:icon="@drawable/ic_time"
        android:dialogIcon="@drawable/ic_time"
        android:defaultValue="@integer/DEFAULT_settings_file_transfer_retardation_ms"
        android:key="@string/KEY_settings_file_transfer_retardation_ms"
        android:selectAllOnFocus="true"
        android:singleLine="true"
        app:singleLineTitle="true"
        android:title="@string/SETTINGS_file_transfer_retardation_ms"
        android:summary="@string/SETTINGS_SUMMARY_file_transfer_retardation_ms"
        app:useSimpleSummaryProvider="true"
        android:inputType="numberDecimal"
        />

    <CheckBoxPreference
        android:defaultValue="@bool/DEFAULT_settings_dry_run"
        android:key="@string/KEY_settings_dry_run"
        android:title="@string/SETTINGS_dry_run"
        android:summary="@string/SETTINGS_SUMMARY_dry_run"
        />

    <androidx.preference.EditTextPreference
        android:icon="@drawable/ic_parallelism"
        android:dialogIcon="@drawable/ic_parallelism"
        android:defaultValue="@integer/DEFAULT_settings_file_transfer_parallelism"
        android:key="@string/KEY_settings_file_transfer_parallelism"
        android:selectAllOnFocus="true"
        android:singleLine="true"
        app:singleLineTitle="true"
        android:title="@string/SETTINGS_file_transfer_parallelism"
        android:summary="@string/SETTINGS_SUMMARY_file_transfer_parallelism"
        app:useSimpleSummaryProvider="true"
        android:inputType="numberDecimal"
        />

    <androidx.preference.EditTextPreference
        android:icon="@drawable/ic_buffer_size"
        android:dialogIcon="@drawable/ic_buffer_size"
        android:defaultValue="@integer/DEFAULT_stream_copying_buffer_size"
        android:key="@string/KEY_settings_stream_copying_buffer_size"
        android:singleLine="true"
        app:singleLineTitle="true"
        android:selectAllOnFocus="true"
        android:title="@string/SETTINGS_stream_copying_buffer_size"
        android:summary="@string/SETTINGS_SUMMARY_stream_copying_buffer_size"
        app:useSimpleSummaryProvider="true"
        android:inputType="numberDecimal"
        />

</PreferenceScreen>